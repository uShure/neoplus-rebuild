---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeadForm from "../components/LeadForm.astro";
import { BASE_URL, contacts } from "../lib";

interface Props {
  title: string;
  description?: string;
  /** path without domain, with trailing slash; "/" for home */
  path?: string;
  ogImage?: string;
  breadcrumbs?: { name: string; href?: string }[];
  /** extra JSON-LD blocks */
  jsonLd?: Record<string, any>[];
  canonicalOverride?: string;
  robots?: string;
}

const { title, description, path = "/", ogImage = "/img/og.webp", breadcrumbs = [], jsonLd = [], canonicalOverride, robots = "index, follow" } = Astro.props;
const canonical = canonicalOverride ?? BASE_URL + path;

const clinicLd = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "Балашихинский наркологический центр",
  alternateName: "Клиника Нео+",
  url: BASE_URL + "/",
  logo: BASE_URL + "/img/logo.png",
  image: BASE_URL + ogImage,
  description:
    "Балашихинский наркологический центр: анонимная помощь 24/7 — вывод из запоя, кодирование, реабилитация, психиатрия.",
  telephone: "+7 (800) 200-24-46",
  email: contacts.emails[0],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Балашиха",
    streetAddress: "улица Советская, 47",
    addressCountry: "RU",
  },
  medicalSpecialty: ["Addiction Medicine", "Psychiatry"],
  priceRange: "₽₽",
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "00:00",
    closes: "23:59",
  },
};

const breadcrumbLd =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Главная", item: BASE_URL + "/" },
          ...breadcrumbs.map((b, i) => ({
            "@type": "ListItem",
            position: i + 2,
            name: b.name,
            ...(b.href ? { item: BASE_URL + b.href } : {}),
          })),
        ],
      }
    : null;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("anim");
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Балашихинский наркологический центр" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={BASE_URL + ogImage} />
    <meta property="og:locale" content="ru_RU" />
    <link rel="icon" href="/img/favicon.png" type="image/png" />
    <link rel="preload" href="/fonts/20_UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa0ZL7W0Q5n-wU.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/20_UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/23_xn7gYHE41ni1AdIRggOxSvfedN62Zw.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face{font-family:'Inter';font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/20_UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa0ZL7W0Q5n-wU.woff2) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
      @font-face{font-family:'Inter';font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/20_UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-family:'Manrope';font-style:normal;font-weight:700;font-display:swap;src:url(/fonts/23_xn7gYHE41ni1AdIRggOxSvfedN62Zw.woff2) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
    </style>
    <link rel="stylesheet" href="/fonts/fonts.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="/fonts/fonts.css" /></noscript>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(clinicLd)} />
    {breadcrumbLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    {jsonLd.map((ld) => <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <!-- Яндекс.Метрика 66047221 — ID перенесён со старого сайта.
         Грузим после первого взаимодействия посетителя или через 5 с idle,
         чтобы аналитика не блокировала рендер. -->
    <script is:inline>
      (function () {
        var fired = false;
        function go() {
          if (fired) return; fired = true;
          window.removeEventListener("scroll", ev); window.removeEventListener("pointerdown", ev);
          window.removeEventListener("keydown", ev); window.removeEventListener("touchstart", ev);
          (function (m, e, t, r, i, k, a) {
            m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
            m[i].l = 1 * new Date();
            for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
            k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a);
          })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
          ym(66047221, "init", { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: false });
        }
        function ev() { go(); }
        ["scroll", "pointerdown", "keydown", "touchstart"].forEach(function (t) { window.addEventListener(t, ev, { once: true, passive: true }); });
        setTimeout(go, 5000);
      })();
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/66047221" style="position:absolute;left:-9999px" alt="" /></div></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header />

    <main id="main">
      {
        breadcrumbs.length > 0 && (
          <nav class="container-x pt-5" aria-label="Хлебные крошки">
            <ol class="flex flex-wrap items-center gap-1.5 text-[13px] text-ink-600">
              <li>
                <a class="hover:text-brand-600" href="/">
                  Главная
                </a>
              </li>
              {breadcrumbs.map((b) => (
                <>
                  <li aria-hidden="true">/</li>
                  {b.href ? (
                    <li>
                      <a class="hover:text-brand-600" href={b.href}>
                        {b.name}
                      </a>
                    </li>
                  ) : (
                    <li aria-current="page" class="text-ink-900">
                      {b.name}
                    </li>
                  )}
                </>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>

    <Footer />

    <!-- Плавающая панель связи: выезжает после первого экрана, не перекрывает контент -->
    <div id="float-contact" class="pointer-events-none fixed bottom-4 left-1/2 z-40 flex w-[calc(100%-2rem)] max-w-md -translate-x-1/2 translate-y-6 gap-2 opacity-0 transition-all duration-300" role="complementary" aria-label="Быстрая связь">
      <a href="tel:+78002002446" class="btn-primary flex-1 !py-2.5 text-[15px]">Позвонить</a>
      <button data-open-modal class="btn-secondary flex-1 !py-2.5 text-[15px]">Записаться</button>
    </div>

    <!-- Toast: результат отправки формы -->
    <div id="toast" class="pointer-events-none fixed bottom-6 right-6 z-[70] hidden max-w-sm items-start gap-3 rounded-xl border border-line-200 bg-white p-4 shadow-[0_12px_32px_rgb(16_24_40/0.16)]">
      <span id="toast-icon" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ok-600/10 text-ok-600" aria-hidden="true">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
      </span>
      <p id="toast-text" class="text-[14px] leading-snug text-ink-900"></p>
    </div>

    <!-- Модальная форма записи -->
    <div id="modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-ink-900/50 p-4" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl bg-white p-6 md:p-8">
        <div class="mb-4 flex items-start justify-between">
          <h2 id="modal-title" class="text-[24px]">Записаться на приём</h2>
          <button data-close-modal class="rounded-lg p-2 hover:bg-brand-50" aria-label="Закрыть">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <p id="modal-service-chip" class="mb-3 hidden rounded-lg bg-brand-50 px-3 py-2 text-[14px] font-medium text-brand-700">
          Услуга: <span id="modal-service-name"></span>
        </p>
        <LeadForm source="modal" compact heading="" />
      </div>
    </div>

    <!-- Cookie-баннер (152-ФЗ) -->
    <div id="cookie-banner" class="fixed bottom-4 right-4 z-50 hidden max-w-sm rounded-xl border border-line-200 bg-white p-4 shadow-[0_8px_30px_rgb(16_24_40/0.12)]">
      <p class="text-[14px] text-ink-600">
        Мы используем cookie и Яндекс.Метрику для работы сайта и аналитики.
        Подробнее — <a class="text-brand-600 underline" href="/politika-konfidentsialnosti/">в политике конфиденциальности</a>.
      </p>
      <button id="cookie-ok" class="btn-primary mt-3 w-full !py-2 text-[14px]">Хорошо</button>
    </div>

    <script>
      // модалка (+ контекст выбранной услуги из каталога)
      const modal = document.getElementById("modal");
      const serviceChip = document.getElementById("modal-service-chip");
      const serviceName = document.getElementById("modal-service-name");
      const setServiceContext = (svc) => {
        window.__leadService = svc || null;
        if (serviceChip && serviceName) {
          serviceName.textContent = svc || "";
          serviceChip.classList.toggle("hidden", !svc);
        }
      };
      const openers = document.querySelectorAll("[data-open-modal]");
      const closers = document.querySelectorAll("[data-close-modal]");
      openers.forEach((b) =>
        b.addEventListener("click", () => {
          setServiceContext(b.dataset.service || null);
          modal?.classList.remove("hidden");
          modal?.classList.add("flex");
        })
      );
      const closeModal = () => {
        setServiceContext(null);
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");
      };
      closers.forEach((b) => b.addEventListener("click", closeModal));
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
      });

      // плавающая панель после 600px скролла (slide-up)
      const fc = document.getElementById("float-contact");
      const onScroll = () => {
        if (!fc) return;
        const show = window.scrollY > 600;
        fc.classList.toggle("opacity-0", !show);
        fc.classList.toggle("translate-y-6", !show);
        fc.classList.toggle("pointer-events-none", !show);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // toast по событию формы
      const toast = document.getElementById("toast");
      const toastText = document.getElementById("toast-text");
      const toastIcon = document.getElementById("toast-icon");
      let toastTimer;
      document.addEventListener("lead:done", (e) => {
        const ok = e.detail?.ok;
        if (!toast || !toastText) return;
        toastText.textContent = ok
          ? "Заявка отправлена — перезвоним в ближайшие минуты."
          : "Не удалось отправить. Позвоните: +7 (800) 200-24-46";
        toastIcon?.classList.toggle("bg-ok-600/10", ok);
        toastIcon?.classList.toggle("text-ok-600", ok);
        toastIcon?.classList.toggle("bg-danger-600/10", !ok);
        toastIcon?.classList.toggle("text-danger-600", !ok);
        toast.classList.remove("hidden");
        toast.classList.add("flex");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.add("hidden");
          toast.classList.remove("flex");
        }, 4500);
      });

      // cookie-баннер
      const cb = document.getElementById("cookie-banner");
      if (cb && !localStorage.getItem("cookie-ok")) {
        cb.classList.remove("hidden");
        document.getElementById("cookie-ok")?.addEventListener("click", () => {
          localStorage.setItem("cookie-ok", "1");
          cb.classList.add("hidden");
        });
      }
    </script>
    <script>
      import "../scripts/motion";
    </script>
    <!-- Лайтбокс (галерея, дипломы врачей, любые [data-lightbox]) -->
    <div id="lightbox" class="fixed inset-0 z-[80] hidden cursor-zoom-out items-center justify-center bg-ink-900/92 p-6" role="dialog" aria-modal="true" aria-label="Просмотр изображения">
      <figure class="text-center">
        <img id="lightbox-img" src="" alt="" class="max-h-[88vh] max-w-full rounded-xl shadow-2xl" />
        <figcaption id="lightbox-cap" class="mt-3 text-[14px] text-white/80"></figcaption>
      </figure>
      <button id="lightbox-close" class="absolute right-5 top-5 rounded-lg p-2 text-white/80 hover:bg-white/10" aria-label="Закрыть">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <script>
      // лайтбокс: делегирование, работает для любых [data-lightbox] на странице
      const lb = document.getElementById("lightbox");
      const lbImg = document.getElementById("lightbox-img");
      const lbCap = document.getElementById("lightbox-cap");
      const openLb = (btn) => {
        if (!lb || !lbImg) return;
        lbImg.src = btn.dataset.src || "";
        lbImg.alt = btn.dataset.caption || "";
        if (lbCap) lbCap.textContent = btn.dataset.caption || "";
        lb.classList.remove("hidden");
        lb.classList.add("flex");
      };
      const closeLb = () => {
        if (!lb) return;
        lb.classList.add("hidden");
        lb.classList.remove("flex");
      };
      document.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-lightbox]");
        if (btn) { openLb(btn); return; }
        if (e.target === lb || e.target.closest("#lightbox-close")) closeLb();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lb && !lb.classList.contains("hidden")) closeLb();
      });
    </script>
  </body>
</html>
