---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import { contacts, PHONE_MAIN, PHONE_MAIN_TEL, PHONE_MOBILE, PHONE_MOBILE_TEL, EMAIL_MAIN, telHref } from "../lib";

const title = "Контакты Балашихинского наркологического центра";
const description =
  "Контакты Балашихинского наркологического центра: телефон +7 (800) 200-24-46 (круглосуточно), адрес контакт-центра — ул. Советская, 47, выезд врача по городу и округе.";
---

<Base title={title} description={description} path="/kontakty/" breadcrumbs={[{ name: "Контакты" }]}>
  <section class="container-x py-10">
    <h1 class="text-[28px] md:text-[40px]">Контакты Балашихинского наркологического центра</h1>

    <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_380px]">
      <div class="grid gap-5 md:grid-cols-2">
        <div class="card p-6">
          <h2 class="text-[18px]">Телефоны</h2>
          <ul class="mt-3 grid gap-2 text-[16px]">
            <li>
              <a class="text-[20px] font-semibold text-brand-600" href={telHref(PHONE_MAIN)}>{PHONE_MAIN}</a>
              <p class="text-[13px] text-ink-600">бесплатно по РФ, круглосуточно</p>
            </li>
            <li>
              <a class="font-medium text-ink-900" href={telHref(PHONE_MOBILE)}>{PHONE_MOBILE}</a>
            </li>
          </ul>
        </div>

        <div class="card p-6">
          <h2 class="text-[18px]">Почта</h2>
          <ul class="mt-3 grid gap-2 text-[15px]">
            <li><a class="text-brand-600" href={"mailto:" + EMAIL_MAIN}>{EMAIL_MAIN}</a> <span class="text-ink-400">— заявки</span></li>
            {contacts.emails.filter((e) => e !== EMAIL_MAIN).map((e) => (
              <li><a class="text-brand-600" href={"mailto:" + e}>{e}</a></li>
            ))}
          </ul>
        </div>

        <div class="card p-6 md:col-span-2">
          <h2 class="text-[18px]">Адрес и выезд</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-900/90">
            Контакт-центр: {contacts.address_contact_center}. Мобильные бригады выезжают по Балашихе и округе
            круглосуточно; приём в клинике и стационар — по согласованию с координатором.
          </p>
          <a
            class="btn-secondary mt-4"
            href="https://www.google.com/maps/search/?api=1&query=%D0%91%D0%B0%D0%BB%D0%B0%D1%88%D0%B8%D1%85%D0%B0%2C+%D1%83%D0%BB%D0%B8%D1%86%D0%B0+%D0%A1%D0%BE%D0%B2%D0%B5%D1%82%D1%81%D0%BA%D0%B0%D1%8F%2C+47"
            target="_blank"
            rel="noopener nofollow"
          >
            Открыть карту
          </a>
        </div>

        <div class="card p-6 md:col-span-2">
          <h2 class="text-[18px]">Юридическая информация</h2>
          <div class="mt-3 grid gap-3 text-[14px] leading-relaxed text-ink-600 md:grid-cols-2">
            <p>
              <strong class="text-ink-900">{contacts.legal_entity}</strong><br />
              ИНН {contacts.inn} · ОГРН {contacts.ogrn}<br />
              Лицензия {contacts.license_main.number} от {contacts.license_main.date}<br />
              {contacts.license_main.address}
            </p>
            <p>
              Стационарные услуги оказываются партнёром — <strong class="text-ink-900">{contacts.license_stacionar_partner.entity}</strong><br />
              Лицензия {contacts.license_stacionar_partner.number} от {contacts.license_stacionar_partner.date}<br />
              {contacts.license_stacionar_partner.address}
            </p>
          </div>
        </div>
      </div>

      <aside id="zapis" class="scroll-mt-24">
        <div class="card p-6 lg:sticky lg:top-28">
          <h2 class="text-[20px]">Оставить заявку</h2>
          <p class="mb-4 mt-1 text-[14px] text-ink-600">Перезвоним анонимно за несколько минут.</p>
          <LeadForm source="kontakty" compact heading="" />
        </div>
      </aside>
    </div>
  </section>
</Base>

