---
import Base from "../layouts/Base.astro";
import PriceTable from "../components/PriceTable.astro";
import Faq from "../components/Faq.astro";
import DoctorCard from "../components/DoctorCard.astro";
import LeadForm from "../components/LeadForm.astro";
import { services, doctors, img, BASE_URL, shortServiceName, type ServicePage } from "../lib";

export function getStaticPaths() {
  return (services as ServicePage[]).map((s) => ({
    params: { service: s.path },
    props: { s },
  }));
}

const { s } = Astro.props;
const localHero = img(s.hero_img);
const dirName = s.direction || "Услуги";
const dirHref = "/karta-sayta/";

// только те цены, у которых реально есть значение
const priceRows = s.prices.filter((r) => r.name);

const offerLd = s.prices.some((r) => r.price)
  ? {
      "@context": "https://schema.org",
      "@type": "MedicalProcedure",
      name: s.h1,
      description: s.description,
      url: BASE_URL + "/" + s.path + "/",
      procedureType: "https://schema.org/TherapeuticProcedure",
      offers: {
        "@type": "Offer",
        priceCurrency: "RUB",
        price: s.prices.find((r) => r.price)?.price?.replace(/[^\d]/g, ""),
        availability: "https://schema.org/InStock",
      },
    }
  : null;

const faqLd =
  s.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: s.faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;
---

<Base
  title={s.title || s.h1}
  description={s.description}
  path={"/" + s.path + "/"}
  breadcrumbs={[{ name: dirName, href: dirHref }, { name: shortServiceName(s.h1) }]}
  jsonLd={[...(offerLd ? [offerLd] : []), ...(faqLd ? [faqLd] : [])]}
>
  <!-- HERO услуги -->
  <section class="bg-brand-800 bg-[linear-gradient(160deg,#123a66_0%,#1d5fa9_60%,#4a8cc7_100%)] text-white">
    <div class="container-x grid gap-10 py-12 lg:grid-cols-[1fr_400px] lg:py-16">
      <div>
        <h1 class="max-w-2xl text-[28px] leading-tight md:text-[40px]">{s.h1}</h1>
        {s.hero_lead && <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-white/80 md:text-[18px]">{s.hero_lead}</p>}
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="tel:+78002002446" class="btn-accent">Вызвать врача</a>
          <button data-open-modal class="btn !border !border-white/40 !bg-white/10 !text-white hover:!bg-white/20">Записаться</button>
        </div>
        {s.consultation_links && (
          <ul class="mt-7 grid gap-2 sm:grid-cols-2">
            {s.consultation_links.map((l) => (
              <li>
                <a href={l.href} class="flex items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-[15px] font-medium text-white transition-colors duration-150 hover:border-accent-500/60 hover:bg-white/10">
                  <svg class="h-4 w-4 shrink-0 text-accent-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[14px] text-white/85">
          {s.hero_facts?.map((f) => (
            <span class="inline-flex items-center gap-2">
              <svg class="h-4 w-4 text-accent-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {f}
            </span>
          ))}
        </div>
        {s.hero_price && <p class="mt-4 text-[15px] text-white/75">{s.hero_price}</p>}
      </div>
      <aside class="rounded-2xl bg-white p-6 text-ink-900 shadow-[0_16px_40px_rgb(6_20_40/0.35)]">
        <h2 class="text-[20px]">Записаться</h2>
        <p class="mb-4 mt-1 text-[14px] text-ink-600">Ответим анонимно, перезвоним за несколько минут.</p>
        <LeadForm source="service" compact heading="" />
      </aside>
    </div>
  </section>

  <!-- ЦЕНЫ -->
  {priceRows.length > 0 && (
    <section class="container-x py-12" aria-labelledby="svc-prices">
      <h2 id="svc-prices" class="mb-6 text-[26px] md:text-[30px]">
        {(() => {
          const n = shortServiceName(s.h1);
          return "Цены: " + (n.charAt(0).toLowerCase() + n.slice(1));
        })()}
      </h2>
      <PriceTable rows={priceRows} id={s.path} />
      <p class="mt-3 text-[13px] text-ink-400">Скидка 10% при заказе через форму на сайте.</p>
    </section>
  )}

  <!-- ТЕКСТ -->
  {s.sections.length > 0 && (
    <section class="bg-brand-50 py-12">
      <div class="container-x mx-auto max-w-[820px]">
        {s.sections.map((sec) => (
          <div class="mb-8 last:mb-0">
            {sec.heading && <h2 class="mb-4 text-[26px] md:text-[30px]">{sec.heading}</h2>}
            <div class="grid gap-2">
              {sec.items
                .filter((it) => !(it.tag === "h2" && it.text === sec.heading))
                .map((it) =>
                  it.tag === "li" ? (
                    <div class="flex gap-2.5 text-[16px] leading-relaxed text-ink-900/90">
                      <svg class="mt-1.5 h-4 w-4 shrink-0 text-accent-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                      <span>{it.text}</span>
                    </div>
                  ) : it.tag === "h3" ? (
                    <h3 class="mt-5 text-[20px]">{it.text}</h3>
                  ) : (
                    <p class="text-[16px] leading-relaxed text-ink-900/90">{it.text}</p>
                  )
                )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {s.faq.length > 0 && (
    <section class="container-x py-12">
      <div class="mx-auto max-w-[820px]">
        <Faq items={s.faq} heading="Частые вопросы" />
      </div>
    </section>
  )}

  <!-- ВРАЧИ -->
  <section class="bg-brand-50 py-12" aria-labelledby="svc-docs">
    <div class="container-x">
      <h2 id="svc-docs" class="mb-6 text-[26px] md:text-[30px]">Врачи по этому направлению</h2>
      <div class="relative" data-carousel>
    <button data-carousel-prev aria-label="Предыдущий" class="absolute left-2 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-line-200 bg-white text-brand-800 shadow-[0_6px_20px_rgb(16_24_40/0.16)] transition-colors hover:bg-brand-50 md:flex">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button data-carousel-next aria-label="Следующий" class="absolute right-2 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-line-200 bg-white text-brand-800 shadow-[0_6px_20px_rgb(16_24_40/0.16)] transition-colors hover:bg-brand-50 md:flex">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>        <div class="carousel-track flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2" data-carousel-track>
          {doctors.map((d) => (
            <div class="w-[228px] shrink-0 snap-start sm:w-[256px]">
              <DoctorCard doctor={d} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA + дисклеймер -->
  <section class="container-x py-12">
    <div class="rounded-2xl bg-brand-800 p-6 text-white md:p-10" data-reveal="scale">
      <div class="grid items-center gap-6 lg:grid-cols-[1fr_380px]">
        <div>
          <h2 class="text-[24px] md:text-[28px]">Остались вопросы? Позвоните — консультация бесплатна</h2>
          <p class="mt-2 text-white/80">Координатор на связи в любое время суток — ответит на вопросы и сразу запишет к нужному специалисту.</p>
        </div>
        <a href="tel:+78002002446" class="btn-accent w-full">+7 (800) 200-24-46</a>
      </div>
    </div>
  </section>
</Base>
