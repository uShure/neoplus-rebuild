---
import Base from "../layouts/Base.astro";
---

<Base title="Страница не найдена | Балашихинский наркологический центр" description="Страница не найдена. Перейдите на главную или позвоните нам: +7 (800) 200-24-46 — работаем круглосуточно." path="/404" robots="noindex, follow">
  <section class="container-x py-24 text-center">
    <p class="font-display text-[64px] font-bold text-brand-600 md:text-[96px]">404</p>
    <h1 class="mt-2 text-[26px] md:text-[32px]">Такой страницы нет</h1>
    <p class="mx-auto mt-3 max-w-md text-ink-600">
      Возможно, страница переехала. Нужна срочная помощь — просто позвоните, мы на связи круглосуточно.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">На главную</a>
      <a href="/tseny/" class="btn-secondary">Цены на услуги</a>
      <a href="tel:+78002002446" class="btn-accent">+7 (800) 200-24-46</a>
    </div>
  </section>
</Base>
