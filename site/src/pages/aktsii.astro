---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import { promos, img } from "../lib";

const title = "Акции и скидки Балашихинского наркологического центра";
const description =
  "Действующие акции Балашихинского наркологического центра: скидки на кодирование, детоксикацию и консультации. Подробности у координатора: +7 (800) 200-24-46.";
---

<Base title={title} description={description} path="/aktsii/" breadcrumbs={[{ name: "Акции" }]}>
  <section class="container-x py-10">
    <h1 class="text-[28px] md:text-[40px]">Акции и специальные предложения</h1>
    <p class="mt-3 max-w-2xl text-[16px] text-ink-600">
      Условия акций уточняйте у координатора — количество мест ограничено.
    </p>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {promos.map((p) => {
        const pic = img(p.image);
        return (
          <div class="card flex flex-col overflow-hidden">
            {pic && (
              <img src={pic} alt={p.title} width="800" height="450" class="aspect-video w-full object-cover" loading="lazy" decoding="async" />
            )}
            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-[20px] leading-snug">{p.title}</h2>
              <p class="mt-2 flex-1 text-[15px] leading-relaxed text-ink-600">{p.text}</p>
              <button data-open-modal class="btn-primary mt-4 self-start">Получить скидку</button>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Base>
